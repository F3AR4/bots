{
  "name": "polymarket-copy-trader",
  "version": "1.0.0",
  "description": "Polymarket Copy-Trading Research & Paper-Trading Foundation System",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "build": "tsc",
    "build:client": "vite build",
    "dev:client": "vite",
    "start": "tsx src/index.ts",
    "web": "tsx src/web/server.ts",
    "seed": "tsx src/cli/runner.ts seed",
    "scan:leaderboard": "tsx src/cli/runner.ts scan:leaderboard",
    "scan:wallets": "tsx src/cli/runner.ts scan:wallets",
    "monitor:trades": "tsx src/cli/runner.ts monitor:trades",
    "score:trades": "tsx src/cli/runner.ts score:trades",
    "paper:update-pnl": "tsx src/cli/runner.ts update-pnl",
    "review:outcomes": "tsx src/cli/runner.ts review:outcomes",
    "update:rules": "tsx src/cli/runner.ts update:rules",
    "report:daily": "tsx src/cli/runner.ts report:daily",
    "research:copyability": "tsx src/cli/runner.ts research:copyability",
    "monitor:wallets": "tsx src/cli/runner.ts monitor:wallets",
    "pipeline:cycle": "tsx src/cli/runner.ts pipeline:cycle",
    "calibrate": "tsx src/cli/calibrate-runner.ts calibrate",
    "calibrate:report": "tsx src/cli/calibrate-runner.ts calibrate:report",
    "rules:history": "tsx src/cli/calibrate-runner.ts rules:history",
    "rules:candidates": "tsx src/cli/calibrate-runner.ts rules:candidates",
    "bot:start": "tsx src/cli/bot-daemon.ts start",
    "bot:stop": "tsx src/cli/bot-daemon.ts stop",
    "bot:status": "tsx src/cli/bot-daemon.ts status",
    "bot:run": "tsx src/cli/bot-daemon.ts run"
  },
  "keywords": [
    "polymarket",
    "copy-trading",
    "research",
    "paper-trading"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "wouter": "^3.11.0"
  }
}
